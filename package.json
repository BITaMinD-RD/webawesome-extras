{
  "name": "webawesome-extras",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Components that look and work as if they were native Web Awesome ones: custom elements wax-*, built with Lit, styled with --wa-* tokens",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test \"src/components/*/*.state.test.js\" \"src/utilities/*.state.test.js\" \"scripts/test/*.test.js\"",
    "test:browser": "wtr",
    "manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "react": "node scripts/react.mjs",
    "docs": "node scripts/docs.mjs",
    "build": "npm run manifest && npm run react && npm run docs"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "^3.0.0",
    "@lit/react": "^1.0.0",
    "lit": "^3.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@awesome.me/webawesome": {
      "optional": true
    },
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit/react": "^1.0.8",
    "@open-wc/testing": "^5.0.0",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "lit": "^3.3.3",
    "marked": "^11.2.0",
    "react": "^19.3.1"
  },
  "customElements": "node_modules/.cache/cem-check/custom-elements.json"
}
